# Postgres connection used by app/core/db.py.
# Quickest local setup: `docker compose up -d db` from the repo root, which
# matches this default exactly. Auth returns 503 (not a crash) if this isn't
# reachable — every other endpoint keeps working without it.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/travelpilot

# Used to sign auth JWTs — change this for anything beyond local/demo use.
JWT_SECRET=dev-secret-change-in-production

# Comma-separated list of extra allowed frontend origins for CORS, beyond
# the localhost:5173 dev default (e.g. your deployed frontend's URL).
CORS_ORIGINS=

# Optional — enables live LLM calls for recovery explanations, Q&A, and
# itinerary personalization. Falls back to deterministic templated
# responses when unset, so the app is fully functional without these.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
